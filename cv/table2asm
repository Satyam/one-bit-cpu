#!/usr/bin/env zx
const TABLE_NAME = 'turing.table';

const circuits = [
  {
    fileName: TABLE_NAME,
    init: `inFrom 8`,
    snips: {
      print0: `zero\nout`,
      print1: `one\nout`,
      rightPrint1: `one\noutPrev`,
      moveLeft: 'inNext',
      moveRight: 'inPrev',
    },
  },
  {
    fileName: 'tape.turing',
    snips: {
      print0: `#print0\nzero\noutto 1`,
      print1: `#print1\none\noutTo 1`,
      rightPrint1: `#rightPrint1\none\noutTo 0\noutTo 1`,
      moveLeft: '#moveLeft\nzero\noutTo 0\nin',
      moveRight: '#moveRight\none\noutTo 0\nin',
    },
  },
];

const table = await fs.readFile(`${TABLE_NAME}.txt`, 'utf8');

const rxSection = /\{(?<header>.*?)-{3,}(?<states>.*?)\}/gs;
const rxDecl = /^(?<prop>\w+)\s*:\s*(?<val>.+)$/i;
const rxState =
  /(?<state>\w+)\s+(?<symbol>0|1)\s+(?<print>-|0|1)\s+(?<op>-|L|R)\s+(?<next>\w+)$/i;
const rxSetup = /^-*(?<before>[x-]*)\[(?<center>[x-])\](?<after>[x-]*?)\-*$/i;

// used to detect base used for number constants
const rxNumberBases = {
  2: /^0b([01]+)$/,
  8: /^0o([0-7]+)$/,
  16: /^0x([0-9a-fA-F]+)$/,
  10: /^(\d+)$/,
};
let iPrefix = 'A'.charCodeAt(0);

let hasError = false;

const parsed = Array.from(
  table.matchAll(rxSection).map((section) => ({
    headers: parseHeader(section.groups.header),
    states: parseStates(section.groups.states),
  }))
);

if (hasError) {
  process.exit(1);
}

for await (const { fileName, snips, init } of circuits) {
  await fs.writeFile(
    `${fileName}.asm`,
    parsed
      .map(
        ({ headers, states }) => `
    ${generateHeaders(headers)}
    ${init ?? ''}
    ${generateSetup(headers, snips)}
    ${generateStates(states, snips)}
    `
      )
      .join('\n')
  );

  const asm = await $`./assembler.mjs ./${fileName}.asm`;
  console.log(asm.toString());
  if (asm.exitCode) process.exit(asm.exitCode);
  const bytes = await $`./rom2bytes  ./${fileName}.rom`;
  console.log(bytes.toString());
  if (bytes.exitCode) process.exit(bytes.exitCode);
}
process.exit(0);

function parseHeader(header) {
  const headers = { comments: [] };
  header
    .split('\n')
    .map((line) => line.trim())
    .filter((line) => line.length)
    .forEach((line) => {
      try {
        const m = rxDecl.exec(line);
        if (m) {
          const { prop, val } = m.groups;
          switch (prop) {
            case 'org':
              {
                const v = parseValue(val);
                if (v === null) {
                  throw new Error('Invalid value for ORG setting');
                } else {
                  headers.org = v;
                }
              }
              break;
            case 'name':
              headers.name = val;
              break;
            case 'init':
              headers.init = val;
              break;
            case 'setup':
              {
                const m = rxSetup.exec(val.toLowerCase());
                if (m) {
                  Object.assign(headers, m.groups);
                } else {
                  throw new Error('Invalid setup string');
                }
              }
              break;
            default:
              headers.comments.push(line);
              break;
          }
        } else {
          headers.comments.push(line);
        }
      } catch (err) {
        console.error(chalk.red(`${err} in:\n      ${line}`));
        hasError = true;
      }
    });
  return headers;
}

function generateHeaders(headers) {
  return `
# ${headers.name}
${headers.comments.map((c) => `# ${c}`).join('\n')}
${'org' in headers ? `org 0x${headers.org.toString(16)}` : ''}
`;
}

function generateSetup(headers, snips) {
  const mark = (val) => (val === 'x' ? snips.rightPrint1 : snips.moveRight);

  const { before, center, after } = headers;

  return []
    .concat(
      before && Array(before.length + 1).fill(snips.moveLeft),
      before && Array.from(before, mark),
      mark(center),
      after && Array.from(after, mark),
      after && Array(after.length - 1).fill(snips.moveLeft)
    )
    .join('\n');
}

function parseStates(statesTable) {
  const states = {};
  statesTable
    .split('\n')
    .map((line) => line.split('#')[0].trim())
    .filter((line) => line.length)
    .forEach((line) => {
      try {
        const s = rxState.exec(line);
        if (s) {
          const { state, symbol, print, op, next } = s.groups;
          if (!(state in states)) {
            states[state] = [];
          }
          const sts = states[state];
          if (sts[parseInt(symbol)]) {
            throw new Error(`duplicate symbol ${symbol} for state ${state}`);
          }
          sts[parseInt(symbol)] = [print, op, next, line];
        } else {
          throw new Error('???', line);
        }
      } catch (err) {
        console.error(chalk.red(`${err} in:\n      ${line}`));
        hasError = true;
      }
    });
  return states;
}

function generateStates(states, snips) {
  const out = [];
  const prefix = String.fromCharCode(iPrefix++) + '_';
  for (const state of Object.keys(states).sort()) {
    out.push(`\n#State: ${state}\n${prefix}${state}: jmpt ${prefix}${state}_1`);
    states[state].forEach(([print, op, next, line], symbol) => {
      try {
        out.push(`\n# ${state}  ${symbol} ${print} ${op} ${next}`);
        out.push(`${prefix}${state}_${symbol}:`);
        switch (print) {
          case '0':
            symbol && out.push(snips.print0);
            break;
          case '1':
            !symbol && out.push(snips.print1);
            break;
          case '-':
            break;
          default:
            throw new Error(
              `Unknown print command [${print}] in table: ${name}, state:  ${state}`
            );
            break;
        }
        switch (op.toLowerCase()) {
          case 'l':
            out.push(snips.moveLeft);
            break;
          case 'r':
            out.push(snips.moveRight);
            break;
          case '-':
            break;
          default:
            throw new Error(
              `Unknown operation command [${op}] in table: ${name}, state:  ${state}`
            );
            break;
        }
        if (next.toLowerCase() === 'halt') {
          out.push('halt');
        } else {
          if (next in states) {
            out.push(`# Next: ${next} \njmp ${prefix}${next}`);
          } else {
            throw new Error(
              `Next state [${next}] not found in table: ${name}, state: ${state} `
            );
          }
        }
      } catch (err) {
        console.error(chalk.red(`${err} in:\n      ${line}`));
        hasError = true;
      }
    });
  }
  return out.join('\n');
}

function parseValue(arg) {
  // loop over the regular expressions to check for number base prefixes
  // and parse it accordingly if match
  if (arg) {
    for (const [base, rx] of Object.entries(rxNumberBases)) {
      const m = rx.exec(arg.trim());
      if (m) {
        const val = parseInt(m[1], base);
        if (!isNaN(val)) return val;
      }
    }
  }
  return null;
}
