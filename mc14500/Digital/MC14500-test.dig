  <version>2</version>
  <attributes/>
  <visualElements>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>Flags</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>Clk X1 RST  A I   Data Write RR JMP RTN FLG0 FLGF

#       NOP0, NOPF, JMP
program(0,0xf,0xc, 0xd) 

# On C, set =&gt; clock =&gt; compare

# Reset
repeat(3) C   x  1    0 0     z   0     0  0   0   0    0

# NOP0
0   X  0    0 0     z   0     0  0   0   1    0

# NOPF
C   X  0    1 0xf   z   0     0  0   0   0    1

# JMP
C   X  0    2 0xc   z   0     0  1   0   0    0

# RTN
C   X  0    3 0xd   z   0     0  0   1   0    0

</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="200" y="280"/>
    </visualElement>
