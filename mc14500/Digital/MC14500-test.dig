          <testData>
            <dataString>Clk X1 RST  A I   Data Write RR JMP RTN FLG0 FLGF

#       NOP0, NOPF, JMP
program(0,0xf,0xc) 

# Reset
0   X  1    0 0     z   0     0  0   0   0    0
C   X  1    0 0     z   0     0  0   0   0    0
0   X  0    0 0     z   0     0  0   0   0    0
C   X  0    X X     z   0     0  0   0   1    0
0   X  0    1 0xf   z   0     0  0   0   0    1
C   X  0    X X     z   0     0  0   0   0    0
0   X  0    2 0xc   z   0     0  1   0   0    0
</dataString>
          </testData>
        </entry>
