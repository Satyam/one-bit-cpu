<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>2</version>
  <attributes/>
  <visualElements>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>I</string>
        </entry>
        <entry>
          <string>Bits</string>
          <int>4</int>
        </entry>
      </elementAttributes>
      <pos x="580" y="260"/>
    </visualElement>
    <visualElement>
      <elementName>LU.dig</elementName>
      <elementAttributes/>
      <pos x="640" y="220"/>
    </visualElement>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry>
          <string>rotation</string>
          <rotation rotation="3"/>
        </entry>
        <entry>
          <string>Label</string>
          <string>DIn</string>
        </entry>
      </elementAttributes>
      <pos x="640" y="180"/>
    </visualElement>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry>
          <string>rotation</string>
          <rotation rotation="3"/>
        </entry>
        <entry>
          <string>Label</string>
          <string>RR</string>
        </entry>
      </elementAttributes>
      <pos x="720" y="180"/>
    </visualElement>
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes>
        <entry>
          <string>rotation</string>
          <rotation rotation="3"/>
        </entry>
        <entry>
          <string>Label</string>
          <string>NewRR</string>
        </entry>
      </elementAttributes>
      <pos x="680" y="340"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>Test</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>            I     DIn            RR             NewRR

#  NOP 0
repeat(4)   0    bits(1, n &amp; 1) bits(1, n &gt;&gt; 1)   X

# LD
repeat(4)   1    bits(1, n &amp; 1) bits(1, n &gt;&gt; 1)   bits(1, n &amp; 1)

# LDC
repeat(4)   2    bits(1, n &amp; 1) bits(1, n &gt;&gt; 1)   bits(1, !(n &amp; 1))

# AND
repeat(4)   3    bits(1, n &amp; 1) bits(1, n &gt;&gt; 1)   bits(1, (n &amp; 1) &amp; (n &gt;&gt; 1)) 

# ANDC
repeat(4)   4    bits(1, n &amp; 1) bits(1, n &gt;&gt; 1)   bits(1, !(n &amp; 1) &amp; (n &gt;&gt; 1))

# OR
repeat(4)   5    bits(1, n &amp; 1) bits(1, n &gt;&gt; 1)   bits(1, (n &amp; 1) | (n &gt;&gt; 1))

# ORC
repeat(4)   6    bits(1, n &amp; 1) bits(1, n &gt;&gt; 1)   bits(1, !(n &amp; 1) | (n &gt;&gt; 1))

# XNOR
repeat(4)   7    bits(1, n &amp; 1) bits(1, n &gt;&gt; 1)   bits(1, ((n &amp; 1) &amp; (n &gt;&gt; 1)) | (!(n &amp; 1) &amp; !(n &gt;&gt; 1)))
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="320" y="160"/>
    </visualElement>
  </visualElements>
  <wires>
    <wire>
      <p1 x="580" y="260"/>
      <p2 x="640" y="260"/>
    </wire>
    <wire>
      <p1 x="640" y="180"/>
      <p2 x="640" y="220"/>
    </wire>
    <wire>
      <p1 x="720" y="180"/>
      <p2 x="720" y="220"/>
    </wire>
    <wire>
      <p1 x="680" y="300"/>
      <p2 x="680" y="340"/>
    </wire>
  </wires>
  <measurementOrdering/>
</circuit>